# ==========================================================================
# open-accreditation — Backend .env.example (Development Template)
# --------------------------------------------------------------------------
# Copy this file to `.env` (untracked) and fill in your own values.
# Run `php artisan key:generate` to generate APP_KEY.
# Run `php artisan jwt:secret` to generate JWT_SECRET.
# Never commit a real secret.
# ==========================================================================

APP_NAME="Open Accriditation"
# Development template. Production deployments MUST set APP_ENV=production and
# APP_DEBUG=false explicitly (the values below are dev defaults, not be copied
# to prod as-is).
APP_ENV=local
APP_KEY=
# Old keys, comma-separated, used to VERIFY data signed/encrypted with a
# previous APP_KEY (QR tokens, see features/badges-qr.md). Before rotating
# APP_KEY, move the old value here: a badge whose token stops verifying is
# not repairable, because the token itself is the credential a guest scans —
# the stored column is only an index. `accreditation:backfill-qr-tokens`
# re-mints the tokens that were minted with a key no longer listed here.
# APP_PREVIOUS_KEYS=base64:...
# CC-R5: ships disabled so copying this example never exposes debug/Whoops in
# production. Re-enable only for local development.
APP_DEBUG=false
APP_URL=https://accreditation.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# WP-6-e: "database" (the framework default) is the value that propagates —
# `php artisan down` then flips a shared row, so a replica set or several app
# containers all go into maintenance. `file` only works when EVERY instance
# shares the single storage/framework/down file; set it deliberately for a
# single-instance dev box.
APP_MAINTENANCE_DRIVER=database
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Admin bootstrap (DatabaseSeeder uses these via firstOrCreate) ---------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- Database (local dev: Postgres via docker-compose; tests: SQLite :memory:) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=accriditation
DB_USERNAME=accriditation
DB_PASSWORD=accriditation

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset -> the session cookie is `Secure` in every environment except `local`
# (plain-HTTP dev servers reject a Secure cookie). Set explicitly to override,
# e.g. `false` when TLS is terminated by a proxy the app cannot see.
# SESSION_SECURE_COOKIE=true

# --- Reverse proxy / host hardening ----------------------------------------
# Caddy terminates TLS in front of this backend. Without a trusted proxy,
# `$request->isSecure()` is permanently false (absolute URLs in mails/PKPASS
# degrade to http://) and every `$request->ip()`-keyed rate limiter collapses
# all clients into the proxy's single bucket.
# Comma-separated IPs/CIDRs. Unset = loopback (127.0.0.1, ::1), which covers the
# shipped docker-compose topology. `*` trusts the calling IP — only if the proxy
# overwrites the forwarded headers itself.
# TRUSTED_PROXIES=127.0.0.1,::1

# Static part of the `Host` allow-list (regex patterns, comma-separated), on top
# of the hostnames owned by a mandant. Unset = built-in defaults: `localhost`,
# `127.0.0.1`, `::1` plus the dev wildcards `^(.+\.)?test$` / `^(.+\.)?localhost$`
# (the wildcards are omitted in APP_ENV=production). Set it to state exactly
# which static hosts are allowed, e.g. `^intranet\.example\.com$`.
# TRUSTED_HOSTS=

# Emit the JWT cookie with `SameSite=None` instead of `Lax`. Only for a truly
# cross-site deployment (SPA on another origin than the API) — the shipped
# topology is same-origin, so this stays off.
# JWT_CROSS_SITE_COOKIE=true

# CSRF: `EnsureSameOrigin` rejects every state-changing `/api/*` request whose
# `Origin` is foreign, `null` or missing. A request that carries no `Origin`
# AND no `Sec-Fetch-*` header is a non-browser API client (curl, mobile app,
# the Playwright APIRequestContext the E2E suite uses) and is allowed — set this
# to `true` to require an `Origin` from those clients too.
# REQUIRE_ORIGIN_HEADER=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# W1: public media root for brand/team/event-type/badge files (disk `media`),
# served directly by Caddy from a shared volume. Empty -> storage_path('app/media')
# for local development. Production: /srv/media/accreditation (shared Backend+Caddy
# volume, see deployment/docker-compose.yml).
MEDIA_ROOT=

# W11: internal accel delivery. EMPTY = OFF (default) -> the backend streams the
# file through PHP as before. Non-empty (e.g. /__media) -> public/admin show
# routes answer empty 200 + `X-Accel-Redirect: <prefix>/<media-relative-path>`
# and Caddy serves the file from MEDIA_ROOT. Enable ONLY together with the
# `(media_api_accel)` snippet (deployment/caddy-media-api-accel.Caddyfile);
# a mismatch would yield a bodyless 200 (W11 R1).
MEDIA_ACCEL_PREFIX=

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- JWT -------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=10080

# --- Mail (local dev: Mailpit via docker-compose on port 1025/8025) ---------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
