# ==========================================================================
# open-accreditation — Backend .env.example (Development Template)
# --------------------------------------------------------------------------
# Copy this file to `.env` (untracked) and fill in your own values.
# Run `php artisan key:generate` to generate APP_KEY.
# Run `php artisan jwt:secret` to generate JWT_SECRET.
# Never commit a real secret.
# ==========================================================================

APP_NAME="Open Accriditation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://accreditation.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Admin bootstrap (DatabaseSeeder uses these via firstOrCreate) ---------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- Database (local dev: Postgres via docker-compose; tests: SQLite :memory:) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=accriditation
DB_USERNAME=accriditation
DB_PASSWORD=accriditation

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- JWT -------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=10080

# --- Mail (local dev: Mailpit via docker-compose on port 1025/8025) ---------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
