# ==========================================================================
# accriditation-e2e — E2E-/Test-Image (aus accriditation-base abgeleitet)
# --------------------------------------------------------------------------
# Basis: accriditation-base (PHP 8.5 Prod-Runtime, exiftool, ImageMagick, alle
# App-Extensions inkl. pdo_pgsql; Debian trixie) — dieselbe Runtime wie
# Produktion, bis auf den Basis-Snapshot (siehe „Determinismus“ unten).
# Zusätzlich für die E2E-CI (ci.yml, Job `e2e`) vorinstalliert:
#   * Composer (Dist-Binary, wie Prod via composer:latest)
#   * Node.js (aktuelles v26, offizielles Linux-Binary)
#   * pnpm (exakt frontend/package.json#packageManager)
#   * Playwright-Chromium inkl. apt-System-Deps (Version == @playwright/test,
#     aufgelöst aus frontend/pnpm-lock.yaml)
#
# DETERMINISMUS — was der Mechanismus wirklich garantiert (Stand 2026-09-26,
# WP-9-D1/D2). Vorher stand hier „Basis: …:8.5“ ohne jede Einschränkung, was
# eine Stärke suggerierte, die es nicht gab. Jetzt explizit:
#
#   GARANTIERT (für jeden Lauf, in dem die Digest-Auflösung gelingt — der
#   Normalfall, aber nicht garantiert, s.u.): Der Basis-Snapshot ist ein
#   **Digest**, kein Tag. `e2e-image.yml` löst vor dem Build den Digest auf, den
#   `accriditation-base:8.5` gerade hat, und reicht ihn als `BASE_REF` durch.
#   Der tatsächlich benutzte Wert wird als OCI-Label
#   `org.opencontainers.image.base.name` ins Image geschrieben — die Provenienz
#   steht damit AM ARTEFAKT, nicht nur im Log: `docker inspect <image>` (bzw.
#   `docker image inspect` nach einem Pull) beantwortet die Frage „welcher
#   Base-Bitstand steckt in diesem E2E-Image?“ eindeutig.
#
#   GARANTIERT NICHT: dass `e2e-image.yml` den Digest immer auflösen kann. Kann
#   es nicht (Registry-Ausfall, Paket nicht öffentlich, Tooling-Problem), baut der
#   Workflow gegen den beweglichen `:8.5`-Tag weiter — mit sichtbarer
#   `::warning::`-Annotation, also nicht still. Der Fallback ist billig, der
#   Verlust ist nur das Label.
#
#   GARANTIERT NICHT: dass dieses Image bit-reproduzierbar ist. Drei Inputs
#   driften unabhängig vom Repo-Stand: `composer:2` (beweglicher Major-Tag),
#   `latest-v<NODE_MAJOR>.x/` auf nodejs.org (das „latest“-Verzeichnis wandert)
#   und der Base-Digest selbst (rotiert nightly). `PLAYWRIGHT_VERSION` ist gegen
#   das Lockfile fixiert; `PNPM_VERSION` ist eine MAJOR-LINIE (11) und driftet
#   innerhalb ihrer Linie mit — derselbe Typ Fehler wie `composer:2`, nur ohne
#   Build-Eingabe aus dem Repo.
#
#   AUFLÖSUNG DES HÜHN-EI-PROBLEMS: Der Digest ist CI-Laufzeit-Wert (er rotiert
#   mit jedem `base-image.yml`-Lauf) und darf deshalb NICHT im Repo stehen —
#   er würde still altern. Er wird deshalb zur Build-Zeit aus der Registry
#   gelesen. Das ist derselbe Wert, den `base-image.yml` als Job-Output
#   `image_ref` publiziert, und zwar per Konstruktion: EIN Push setzt Tag und
#   Digest, die beiden können nicht auseinanderlaufen. Cross-Workflow-Outputs
#   (`needs:` über Workflow-Grenzen geht nicht, nur `workflow_run`, und das
#   liefe bei den E2E-Triggern nicht mit) waren die einzige Alternative und
#   deutlich fragiler — weg gelassen.
#
#   PREKÄRSTELLE (deshalb das verpflichtende `--platform` am FROM): Der Digest
#   zeigt auf einen OCI-*Index*, nicht auf ein einzelnes Manifest. BuildKit
#   sucht darin nach einem zur Host-Plattform passenden Manifest und bricht hart
#   ab, wenn keins existiert — der Base-Index führt nur `linux/amd64`. Details
#   und Reproduktion am `--platform`-ARGs weiter unten.
#
# INVARIANTE: Es wird NUR die Umgebung eingebacken — niemals App-Code,
# node_modules/ oder vendor/. Die CI mountet den Workspace und installiert
# Dependencies pro Commit. Browser sind an die Playwright-Version gebunden
# -> Rebuild-Trigger siehe .github/workflows/e2e-image.yml.
# ==========================================================================
# Globales Build-Arg (muss VOR dem FROM stehen, damit es in FROM auflösbar ist).
# Default = beweglicher `:8.5`-Tag: das ist der lokale Build ohne Build-Args
# (siehe Kommentar „Determinismus“ oben — dieser Pfad verliert die Provenienz
# bewusst und ist genau der, den der Workflow nie nimmt).
ARG BASE_REF=ghcr.io/reisi007/accriditation-base:8.5
# `--platform=linux/amd64` ist NOTWENDIG, nicht Deko: `base-image.yml` published
# das Base-Image mit `platforms: linux/amd64`, der ghcr-Index enthält also NUR
# ein `linux/amd64`-Manifest (+ Attestation). `FROM <repo>@sha256:<index-digest>`
# lässt BuildKit die Plattform aus dem Index WÄHLEN — auf einem arm64-Host
# (Apple Silicon) findet er keine und bricht mit
#   "no match for platform in manifest: not found"
# hart ab. Mit explizitem `--platform` greift BuildKit das vorhandene
# amd64-Manifest und emuliert es. Lokal verifiziert (Docker 29.5.3,
# buildx 0.35.0, darwin/arm64) — die Erkenntnis kam aus genau diesem Fehler.
# Folgt die Base je Multi-Arch, kann das hier zu `linux/arm64` werden bzw.
# entfallen, sobald der Index beide Plattformen führt.
ARG BASE_PLATFORM=linux/amd64
FROM --platform=${BASE_PLATFORM} ${BASE_REF}

# Globale ARGs sind nach dem FROM nicht im Stage-Scope. Ohne diese erneute
# Deklaration expandiert `${BASE_REF}` im LABEL zu LEER — das Label wäre also
# genau dann leer, wenn man es zum Nachschauen braucht (BuildKit warnt mit
# `UndefinedVar`). Lokal gegengeprüft.
ARG BASE_REF
ARG BASE_PLATFORM

# Provenienz am Artefakt: welcher Basis-Snapshot steckt in diesem Image.
# Steht hier der Tag statt eines Digests, war die Auflösung in
# `e2e-image.yml` nicht möglich — ehrlich statt leer.
LABEL org.opencontainers.image.base.name="${BASE_REF}"
LABEL org.opencontainers.image.base.platform="${BASE_PLATFORM}"

# --- User (WP-5-b) ----------------------------------------------------------
# `deployment/Dockerfile` endet jetzt mit `USER www-data` (non-root
# PHP-FPM-Master im Prod-Image). Dieses Image erbt die Direktive — die
# Installationsschritte unten (apt-get, npm -g, Playwright-Browser nach
# /ms-playwright) brauchen aber root. Ohne dieses Reset bricht der E2E-Build mit
# Permission-Denied ab, sobald das Base-Image neu gepusht wurde. Der E2E-Runner
# bleibt damit wie bisher root — er ist ein Test-Container, kein Prod-Dienst.
USER root

# --- Build-Args (Workflow e2e-image.yml extrahiert Repo-Werte) -------------
# WP-5-f: Defaults an den Lockfile-Stand angeglichen. Sie greifen nur, wenn das
# Image ohne Build-Args gebaut wird (lokal); der CI-Workflow überschreibt beide.
#   PLAYWRIGHT_VERSION = frontend/pnpm-lock.yaml → '@playwright/test@1.63.0'
#                          (exakt; die Quelle der Wahrheit für Browser-Version)
#   PNPM_VERSION       = MAJOR-LINIE 11 (e2e-image.yml `env:`, dort auch
#                          umgestellt). Vorher stand hier 1.62.1 / 11.21.0 —
#                          der E2E-Container lief damit mit einem Browser, der
#                          nicht zum Lockfile passte, bzw. mit einer pnpm-Version,
#                          die hinter der des Repo-Managers lag.
ARG PLAYWRIGHT_VERSION=1.63.0
ARG NODE_MAJOR=26
ARG PNPM_VERSION=11

# Playwright-Browser liegen global unter /ms-playwright
# (Pfad-Konvention der offiziellen Playwright-Images).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Composer — statisches Dist-Binary (portabel über Debian-Varianten)
# ACHTUNG (CC-R4, weiterhin offen): `composer:2` ist ein BEWEGLICHER Major-Tag.
# Warum trotzdem nicht gepinnt: anders als beim Base-Image gibt es für Composer
# keinen Workflow, der einen `image_ref`-Digest liefert — es gibt also keine
# rotationsfreie Quelle der Wahrheit. Ein im Repo hartkodierter Digest würde
# still altern, und ein `COPY --from` lässt sich nur mit demselben
# Registry-Auflösungs-Trick dynamisieren, den `BASE_REF` für die Base macht
# (Auflösung im Workflow, Digest als Build-Arg) — das wäre machbar, ist aber ein
# eigener Task mit eigenem Drift-Problem, kein Kommentar. Konsequenz für heute:
# das E2E-Image ist NICHT bit-reproduzierbar, siehe der Determinismus-Absatz im
# Kopf dieser Datei. Gleiches gilt für `NODE_MAJOR` (unten) und das
# `latest-v<major>.x`-Verzeichnis auf nodejs.org.
# TODO(CC-R4): entweder `COPY --from=composer:2` genauso digest-parametrisieren
# wie `BASE_REF` (Auflösung im Workflow) oder den Composer gar nicht mehr aus
# dem Image nehmen (Download + SHASUM-Pin analog zum Node-Tarball).
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# System-Utils: git (actions/checkout), curl (Downloads), xz-utils (Node-Tarball),
# unzip/zip (composer dist-Extraktion)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        xz-utils \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Node.js — aktuelles v${NODE_MAJOR}-Binary direkt von nodejs.org
# (distro-agnostisch; latest-v<major>.x-Verzeichnis auflösen, kein
# nodesource-Repo nötig).
# WP-5-f: Das Tarball wird gegen die von nodejs.org mitgelieferte
# SHASUMS256.txt VERIFIZIERT (sha256sum -c), bevor es entpackt wird — vorher
# wurde ein ungeprüftes Binary aus der höchsten tar-Liste des Verzeichnis-
# Index geladen (eine Kompromittierung von CDN/Index wäre damit stillschweigend
# in den E2E-Runner eingebackt worden).
RUN NODE_VERSION="$(curl -fsSL "https://nodejs.org/dist/latest-v${NODE_MAJOR}.x/" \
        | grep -o 'node-v[0-9.]*-linux-x64\.tar\.xz' | head -n1 \
        | sed -E 's/^node-(v[0-9.]+)-linux-x64\.tar\.xz$/\1/')" \
    && [ -n "$NODE_VERSION" ] \
    && curl -fsSL -o /tmp/SHASUMS256.txt "https://nodejs.org/dist/${NODE_VERSION}/SHASUMS256.txt" \
    && curl -fsSL -o "/tmp/node-${NODE_VERSION}-linux-x64.tar.xz" \
        "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz" \
    && printf '%s  %s\n' \
        "$(grep -F " node-${NODE_VERSION}-linux-x64.tar.xz" /tmp/SHASUMS256.txt | cut -d' ' -f1)" \
        "/tmp/node-${NODE_VERSION}-linux-x64.tar.xz" \
        | sha256sum -c - \
    && tar -xJf "/tmp/node-${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1 \
    && rm -f "/tmp/node-${NODE_VERSION}-linux-x64.tar.xz" /tmp/SHASUMS256.txt \
    && node --version && npm --version

# pnpm — MAJOR-LINIE aus PNPM_VERSION (Default/Workflow-Input: 11). `pnpm@11`
# ist für npm eine Range und damit die aktuelle 11.x; ein `packageManager`-Pin
# existiert bewusst nicht mehr (Skill `node-deps`).
RUN npm install -g "pnpm@${PNPM_VERSION}" && pnpm --version

# Playwright-Chromium inkl. apt-System-Deps — Version == @playwright/test.
# DEBIAN_FRONTEND=noninteractive, da playwright apt intern aufruft.
ENV DEBIAN_FRONTEND=noninteractive
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && ls -1 /ms-playwright