# ============================================================================
# (media_overrides) — Caddy snippet: direkte Auslieferung der Brand-Dateien
# ============================================================================
#
# Repo:   open-accreditation / deployment/caddy-media-overrides.Caddyfile
# Paket:  W7; W11 auf Root-Brand-Dateien verkleinert.
# Status: ENTWURF — Go-Live noch nicht freigegeben. Das ist ein Fragment und
#         wird NICHT automatisch geladen; es gehört NICHT in dieses Repo,
#         sondern in die zentrale Proxy-Caddyfile (~/dev/caddyfile/Caddyfile).
#
# WO EINBAUEN
#   1. Die Snippet-Definition `(media_overrides)` in die zentrale Caddyfile
#      aufnehmen — zu den übrigen `(…)`-Snippets und VOR dem ersten `import`.
#   2. In jedem Mandanten-Site-Block (eigene Domain) ergänzen:
#          import media_overrides /srv/media/accreditation
#      WICHTIG: VOR dem SPA-Fallback-Handle `handle { import spa … }` einfügen —
#      `handle`-Blöcke sind in Reihenfolge exklusiv, der erste Treffer gewinnt.
#      Der Argumentpfad ist MEDIA_ROOT (Produktion: /srv/media/accreditation).
#
# W11-ABGRENZUNG (STRICT)
#   Dieser Snippet deckt NUR die deployment-bereitgestellten **Root-Brand-Dateien**
#   ohne DB-Bezug ab (Favicons, Manifest, `logo.svg`, …). Die DB-gestützten
#   Media-Bäume `/teams/*`, `/event-types/*`, `/badges/*` und das Mandant-Logo/
#   Header-Bild werden NICHT mehr hier ausgeliefert, sondern über die
#   auth-gebundenen API-Routen + `(media_api_accel)`
#   (`deployment/caddy-media-api-accel.Caddyfile`): Das Backend bleibt die
#   Autorität (Mandanten-Isolation, 404-Semantik, Cache-Klassen), Caddy liefert
#   die interne Datei per `X-Accel-Redirect` aus.
#
# MOUNT-VORAUSSETZUNG
#   Der Caddy-Container muss dieselbe MEDIA_ROOT wie das Backend am
#   identischen Pfad bind-mounten (read-only genügt, Caddy schreibt nie):
#          /srv/media/accreditation:/srv/media/accreditation:ro
#
# LAYOUT (Single Source of Truth: backend/app/Services/MediaPathService.php)
#   <MEDIA_ROOT>/<file>                            Root-Fallback (global)
#   <MEDIA_ROOT>/<domain>/<file>                   Mandant-Override (Brand)
#   `<domain>` = normalisierter Request-Host (lowercase, Port gestrippt,
#   IDN/Punycode).
#
# FALLBACK-KETTE PRO REQUEST (z. B. GET /logo.svg auf verband-a.example)
#   try_files /{http.request.host}{path} {path} =404
#     1. Domain-Override  <MEDIA_ROOT>/verband-a.example/logo.svg
#     2. Root-Fallback    <MEDIA_ROOT>/logo.svg
#     3. sonst 404 (kein SPA-Fallback — Brand-Pfade liegen nicht im Dist)
#   Bewusste Case-Annahme (L1): Das Backend normalisiert Hosts lowercase; Caddy
#   folgt dem Request-Case. Bei Abweichung greift der Root-Fallback (global) —
#   nie fremdes Mandanten-Media.
#
# SICHERHEIT (W1-F2, L2)
#   `file_server { hide .* }` blendet sämtliche Dotfiles aus (`.env`,
#   `.htaccess`, `.DS_Store`, …). Kein `browse` → keine Directory-Listings.
#
# CACHING
#   Root-Brand-Bilder haben FESTE Namen (`logo.svg`, `favicon.ico`, …): ein
#   Brand-Wechsel schreibt dieselbe URL neu, daher kurz cachen und per ETag
#   revalidieren. Manifest + übrige Nicht-Bilder → no-cache. (Die frühere
#   `/badges/*`-immutable-Regel ist mit W11 entfallen — Badges werden über den
#   API+Accel-Weg mit dem vom Backend gesetzten `immutable` ausgeliefert.)
#
# VALIDIERUNG / DEPLOY
#     docker run --rm -v "$PWD/deployment:/etc/caddy:ro" caddy:2 \
#       caddy validate --config /etc/caddy/<test>.Caddyfile --adapter caddyfile
#   Sync/Reload erst nach Go-Live-Freigabe, außerhalb dieses Repos.
#
#   VALIDATE-HISTORIE: W7 (`Valid configuration`, Cache-/Fallback-/Dotfile-
#   Laufzeit-Re-Check grün). W11: `(media_overrides)` + `(media_api_accel)`
#   gemeinsam validiert; Laufzeitmatrix C1–C7 grün (Accel-Datei, Cache-Survival,
#   kein Header-Leak, Spoof-Strip, GET-Gate, Dotfile-404).
#
# GO-LIVE-OFFEN
#   - MEDIA_ROOT auf dem Host anlegen/befüllen (Root-Fallback = Brand-Dateien).
#   - `(media_overrides)` + `(media_api_accel)` in alle Mandanten-Site-Blöcke
#     aufnehmen; MEDIA_ACCEL_PREFIX erst NACH dem Snippet setzen (Risiko R1).
#   - Alias-Domains / Case-Annahme vor Go-Live klären.
#
# ============================================================================
(media_overrides) {
	@media_paths {
		# Brand-/Meta-Dateien (Root-Pfade der SPA; Satz aus features/03).
		path /logo.svg
		path /logo-mono.svg
		path /favicon.svg
		path /favicon.ico
		path /favicon-16x16.png
		path /favicon-32x32.png
		path /apple-touch-icon.png
		path /android-chrome-192x192.png
		path /android-chrome-512x512.png
		path /safari-pinned-tab.svg
		path /mstile-150x150.png
		path /browserconfig.xml
		path /site.webmanifest
	}

	handle @media_paths {
		# Site-Root nur für diesen Handler: MEDIA_ROOT ({args[0]}).
		root * {args[0]}

		# Feste Namen (`logo.svg`, `favicon.ico`, …): kurz cachen + ETag-
		# Revalidierung statt 1 Jahr stale. Nur 2xx.
		@media_images {
			path *.png *.jpg *.jpeg *.webp *.avif *.gif *.svg *.ico
		}
		header @media_images {
			Cache-Control "public, max-age=3600, must-revalidate"
			match status 2xx
		}

		# Manifest + alle übrigen Nicht-Bilder: nie cachen.
		@media_nocache not path *.png *.jpg *.jpeg *.webp *.avif *.gif *.svg *.ico
		header @media_nocache Cache-Control "no-cache, no-store, must-revalidate"
		header @media_nocache Pragma "no-cache"

		# Domain-Override → Root-Fallback → 404.
		try_files /{http.request.host}{path} {path} =404

		file_server {
			# W1-F2: sämtliche Dotfiles niemals ausliefern.
			hide .*
		}
	}
}
