{
    "name": "open-accreditation-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.23.0",
    "scripts": {
        "dev": "vite",
        "prebuild": "tsc -b && node scripts/check-i18n.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "test:e2e:grep": "playwright test --grep",
        "test:e2e:failed": "playwright test --last-failed",
        "test:e2e:ui": "playwright test --ui",
        "test:screenshots": "playwright test -c playwright.screenshots.config.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lingui:extract": "lingui extract",
        "lingui:compile": "lingui compile",
        "check:i18n": "node scripts/check-i18n.mjs"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@lingui/babel-plugin-lingui-macro": "^6.7.0",
        "@lingui/core": "^6.7.0",
        "@lingui/react": "^6.7.0",
        "@lingui/vite-plugin": "^6.7.0",
        "dompurify": "^3.4.15",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.88.0",
        "react-router-dom": "^7.18.1",
        "swr": "^2.4.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@babel/core": "^8.0.5",
        "@eslint/js": "^10.0.1",
        "@iconify-json/material-symbols": "^1.2.92",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@lingui/cli": "^6.7.0",
        "@lingui/format-po": "^6.7.0",
        "@playwright/test": "^1.63.0",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "babel-plugin-react-compiler": "^1.0.0",
        "daisyui": "^5.7.38",
        "eslint": "^10.10.0",
        "eslint-plugin-lingui": "^0.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^4.1.11"
    }
}
