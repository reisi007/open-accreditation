{
    "name": "open-accriditation-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@9.15.4",
    "pnpm": {
        "overrides": {
            "react-router": "7.18.2",
            "nanoid": "3.3.17",
            "brace-expansion": "5.0.9",
            "svgo": "4.0.2",
            "postcss": "8.5.23",
            "undici": "7.29.0"
        }
    },
    "scripts": {
        "dev": "vite",
        "prebuild": "tsc -b && node scripts/check-i18n.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "test:e2e:grep": "playwright test --grep",
        "test:e2e:failed": "playwright test --last-failed",
        "test:e2e:ui": "playwright test --ui",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lingui:extract": "lingui extract",
        "lingui:compile": "lingui compile",
        "check:i18n": "node scripts/check-i18n.mjs"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@lingui/babel-plugin-lingui-macro": "^6.6.0",
        "@lingui/core": "^6.6.0",
        "@lingui/react": "^6.6.0",
        "@lingui/vite-plugin": "^6.6.0",
        "dompurify": "^3.4.13",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.80.0",
        "react-router-dom": "^7.18.1",
        "swr": "^2.4.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@iconify-json/material-symbols": "^1.2.82",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@lingui/cli": "^6.6.0",
        "@lingui/format-po": "^6.6.0",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.9",
        "babel-plugin-react-compiler": "^1.0.0",
        "daisyui": "^5.6.13",
        "eslint": "^10.6.0",
        "eslint-plugin-lingui": "^0.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.3",
        "vitest": "^4.1.9"
    }
}
